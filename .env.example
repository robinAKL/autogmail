# ---- Writing model ---------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Leave empty to use OpenAI's own address
OPENAI_BASE_URL=

# ---- Sending ---------------------------------------------------------------
# How often mail is checked while `python main.py` is running
CHECK_INTERVAL_MINUTES=5

# ---- Gmail -----------------------------------------------------------------
# On this computer: put the Desktop-app credentials.json in this folder instead.
# For the hosted site: a Google Cloud "Web application" client, redirect https://<your-domain>/oauth/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ---- Outlook and SharePoint (one Microsoft Entra app registration) -----------
# Redirect URI: http://localhost:8765/oauth/microsoft/callback (and/or https://<your-domain>/oauth/microsoft/callback)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" accepts work, school and personal accounts. Use your tenant id to allow only your organisation.
MS_TENANT_ID=common

# ---- WhatsApp: fill in ONE of the two options -------------------------------
# Option A: Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; type the same one into the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=
# App secret from the Meta app dashboard; used to check that webhook calls really come from Meta
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0
# Optional approved template, sent to reopen the chat when it has been quiet for 24 hours
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_US
# Option B: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your own number can also be set on the Connections page
WHATSAPP_TO=

# ---- Hosted site (Vercel) ----------------------------------------------------
# Any long random string; keeps sign-ins working
FLASK_SECRET_KEY=
# Vercel Cron calls /cron with this
CRON_SECRET=
# Filled in automatically when Vercel KV / Upstash is connected. Required on Vercel for the
# knowledge base, approvals, WhatsApp and the dashboard to keep anything.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- Public privacy policy at /privacy (Meta and Microsoft ask for one) -------
PRIVACY_OWNER=
PRIVACY_CONTACT=

# ---- Sign-in codes for the hosted site --------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Only these addresses may register and sign in, comma separated. Empty means anyone.
ALLOWED_EMAILS=
